# Contour pipeline env (no secrets in git — fill LOGIN/PASSWORD locally or via Airflow).
# Airflow/pod should inject the same keys; scripts also read this file if present.

SOURCE_MODE=prod
PSI_THRESHOLD=0.3

# Motor.agrafana (prefer full URL, or MSSQL_* below)
GRAFANA_SQLALCHEMY_URL=
MSSQL_HOST=
MSSQL_PORT=1433
MSSQL_DATABASE=Motor
MSSQL_USER=
MSSQL_SA_PASSWORD=
MSSQL_ODBC_DRIVER=ODBC Driver 18 for SQL Server

# Weekly email (DAG Monday 09:00 → alert_email.py)
EMAIL_SMTP_SERVER=internalsmtp.vsk.ru
EMAIL_PORT=2525
EMAIL_SENDER=artificial.intelligence@vsk.ru
EMAIL_LOGIN=
EMAIL_PASSWORD=
EMAIL_RECEIVERS=Gatyatulin@vsk.ru,AVBondarev@vsk.ru,Matsera@VSK.RU
GRAFANA_DASHBOARD_URL=https://grafana.vsk.ru/d/afkhng0p8bym8f/querulus
ALERT_LOOKBACK_DAYS=7
ALERT_WEEKDAY=0
ALERT_DRY_RUN=
ALERT_FORCE=

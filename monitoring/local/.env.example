# Local monitoring stack (copy to .env — do not commit .env)
# Pipeline читает стиль MONITORING_BUU (motor_*/database_*/SERVER_PROD8).
# MSSQL_* — только для образа Microsoft SQL Server и Grafana datasource.

# --- Docker MSSQL container (имена образа Microsoft) ---
MSSQL_PORT=1433
MSSQL_HOST=mssql
MSSQL_DATABASE=Motor
MSSQL_USER=sa
MSSQL_SA_PASSWORD=

# --- Pipeline / Airflow tasks (MONITORING_BUU) ---
motor_host=mssql
motor_name=Motor
motor_user_name=sa
motor_user_pass=
database_host=
database_port=1433
database_name=OISUU_report
database_user_name=
database_user_pass=
SERVER_PROD8=
PORT_PROD8=1521
USER_PROD8=
PASSWORD_PROD8=
SERVICE_NAME_PROD8=

AIRFLOW_PORT=8081
_AIRFLOW_WWW_USER_USERNAME=
_AIRFLOW_WWW_USER_PASSWORD=
AIRFLOW__CORE__FERNET_KEY=

GRAFANA_PORT=3000
GF_SECURITY_ADMIN_USER=
GF_SECURITY_ADMIN_PASSWORD=

# Weekly email (DAG: Mon 09:00 after metrics). Local: ALERT_DRY_RUN=1 or ALERT_FORCE=1.
EMAIL_SMTP_SERVER=internalsmtp.vsk.ru
EMAIL_PORT=2525
EMAIL_SENDER=artificial.intelligence@vsk.ru
EMAIL_LOGIN=
EMAIL_PASSWORD=
EMAIL_RECEIVERS=
ALERT_WEEKDAY=0
ALERT_DRY_RUN=1
ALERT_FORCE=

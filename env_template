# Скопируйте в .env и заполните значения. Файл .env в git не коммитится.

# --- Dataset (пайплайн src/querulus/dataset) ---
# Путь к victim: VICTIM_PARQUET или configs/dataset_sources.json → artifact_paths.victim
# Фильтры victim/исков: configs/dataset_filters.json
VICTIM_PARQUET=
# Legacy parquet Litigant для сверки таргетов (target_compare)
LITIGANT_DATASET_PATH=

# OISUU (pymssql), нужен при USE_SQL=True
OISUU_DB_SERVER=
OISUU_DB_USER=
OISUU_DB_PASSWORD=
OISUU_DB_DATABASE=
OISUU_DB_PORT=1433

# --- Integration (сервис и тесты integration/) ---
OUTBOXML_TRAIN_DF_PATH=
OUTBOXML_MODEL_GROUP=querulus_ansamble_2026_04_09_v1
SERVICE_GIT_COMMIT=

# --- Monitoring (monitoring/) ---
EMAIL_LOGIN=
GRAFANA_SQLALCHEMY_URL=

# --- Обучение (configs/config.py, outboxml) ---
EMAIL_SERVER=
EMAIL_PORT=
EMAIL_SENDER=
EMAIL_PASSWORD=

# --- MLflow (HPO в train_loop / run_hpo) — запись обязательна ---
MLFLOW_TRACKING_URI=https://mlflow.vsk.ru/
# Взаимоисключающие: либо CA-bundle, либо INSECURE_TLS (не оба сразу).
# Пустой SERVER_CERT_PATH= в .env ломает MLflow — строку лучше не оставлять.
# MLFLOW_TRACKING_SERVER_CERT_PATH=/path/to/ca-bundle.crt
# Если CA нет — insecure TLS (self-signed корпоративный HTTPS):
MLFLOW_TRACKING_INSECURE_TLS=true
# Auth: либо готовый Bearer, либо Keycloak login/password (password grant → token).
# MLFLOW_TRACKING_TOKEN=
KEYCLOAK_USERNAME=
KEYCLOAK_PASSWORD=
# Defaults уже под mlflow.vsk.ru / auth.vsk.ru realm users_auth:
# KEYCLOAK_SERVER_URL=https://auth.vsk.ru/auth
# KEYCLOAK_REALM=users_auth
# KEYCLOAK_CLIENT_ID=prod-keycloak_users_auth_lanmlflow-1
# KEYCLOAK_CLIENT_SECRET=   # если client confidential
# KEYCLOAK_SCOPE=openid

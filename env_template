# Скопируйте в .env и заполните значения. Файл .env в git не коммитится.

# --- Dataset (пайплайн src/querulus/dataset) ---
# Путь к victim: VICTIM_PARQUET или configs/dataset_sources.json → artifact_paths.victim
# Фильтры victim/исков: configs/dataset_filters.json
VICTIM_PARQUET=
# Legacy parquet Litigant для сверки таргетов (target_compare)
LITIGANT_DATASET_PATH=

# OISUU (pymssql), нужен при USE_SQL=True
OISUU_DB_SERVER=
OISUU_DB_USER=
OISUU_DB_PASSWORD=
OISUU_DB_DATABASE=
OISUU_DB_PORT=1433

# --- Integration (сервис и тесты integration/) ---
# Скопируйте этот файл в .env в корне querulus (или задайте переменные в shell).
# config.py читает env_template / .env относительно cwd.
# Stem модели — из тела запроса. THRESHOLD — из вектора; иначе DEFAULT ниже.
DEFAULT_CLASSIFICATION_THRESHOLD=0.6
# Shadow 2.0.0: калибраторы (пусто SUBDIR = рядом с pickle в results/)
SHADOW_MODELS_SUBDIR=
SECOND_CF_CALIBRATOR_FILENAME=cf_calibrator.pickle
SECOND_RG_CALIBRATOR_FILENAME=rg_calibrator.pickle
SERVICE_GIT_COMMIT=

# --- Integration tests (artifacts.py / test_parity) ---
# Пусто = defaults: integration/results/, stems ниже, df_for_service_*.parquet
# Синтетика: INTEGRATION_TEST_RESULTS_DIR=integration/results/test_synth
# Prod main: INTEGRATION_TEST_MAIN_STEM=querulus_ansamble_2026_04_18_v1
INTEGRATION_TEST_RESULTS_DIR=
INTEGRATION_TEST_MAIN_STEM=querulus_ansamble_legacy
INTEGRATION_TEST_SECOND_STEM=UU_querulus_2026_10_09_16_51_20
INTEGRATION_TEST_MAIN_PICKLE=
INTEGRATION_TEST_SECOND_PICKLE=
INTEGRATION_TEST_CF_CAL=
INTEGRATION_TEST_RG_CAL=
INTEGRATION_TEST_DF_MAIN=
INTEGRATION_TEST_DF_SECOND=
INTEGRATION_TEST_MAX_ROWS=

# --- Monitoring (monitoring/) ---
EMAIL_LOGIN=
GRAFANA_SQLALCHEMY_URL=

# --- Обучение (configs/config.py, outboxml) ---
EMAIL_SERVER=
EMAIL_PORT=
EMAIL_SENDER=
EMAIL_PASSWORD=
# Список через запятую (или ;)
EMAIL_RECEIVERS=gatyatulin@vsk.ru

# --- MLflow (HPO в train_loop / run_hpo) — запись обязательна ---
MLFLOW_TRACKING_URI=https://mlflow.vsk.ru/
# Взаимоисключающие: либо CA-bundle, либо INSECURE_TLS (не оба сразу).
# Пустой SERVER_CERT_PATH= в .env ломает MLflow — строку лучше не оставлять.
# MLFLOW_TRACKING_SERVER_CERT_PATH=/path/to/ca-bundle.crt
# Если CA нет — insecure TLS (self-signed корпоративный HTTPS):
MLFLOW_TRACKING_INSECURE_TLS=true
# HPO: parent study-run + nested trial_* runs (params/metrics/artifacts).
# Auth: либо готовый Bearer, либо Keycloak login/password (password grant → token).
# MLFLOW_TRACKING_TOKEN=
KEYCLOAK_USERNAME=
KEYCLOAK_PASSWORD=
# Defaults уже под mlflow.vsk.ru / auth.vsk.ru realm users_auth:
# KEYCLOAK_SERVER_URL=https://auth.vsk.ru/auth
# KEYCLOAK_REALM=users_auth
# KEYCLOAK_CLIENT_ID=prod-keycloak_users_auth_lanmlflow-1
# KEYCLOAK_CLIENT_SECRET=   # если client confidential
# KEYCLOAK_SCOPE=openid
